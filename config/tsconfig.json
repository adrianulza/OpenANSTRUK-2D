{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "../src/2d/*"
      ]
    }
  },
  "include": [
    "../src/2d/**/*.ts",
    "../src/2d/**/*.tsx",
    "../config/vite.config.ts",
    "../config/eslint.config.js"
  ],
  "exclude": [
    "../node_modules",
    "../src/3d"
  ]
}
